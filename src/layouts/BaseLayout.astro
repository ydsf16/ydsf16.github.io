---
import '../styles/global.css';
import '../styles/detail.css';
import '../styles/scale.css';
import 'katex/dist/katex.min.css';
import { siteCopy, localizedPath, type Locale } from '../data/site';
const { locale = 'en', title = 'TinyGrape Lab', description: suppliedDescription, image = '/media/brand-banner.png' } = Astro.props;
const normalizedLocale = locale as Locale;
const copy = siteCopy[normalizedLocale];
const description = suppliedDescription || copy.heroBody;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://tinygrape.com.cn';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const pageTitle = `${title} · TinyGrape Lab`;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'en')}`} />
    <link rel="alternate" hreflang="zh-CN" href={`${siteUrl}${localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'zh')}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'en')}`} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TinyGrape Lab" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localizedPath('/', locale as Locale)} aria-label="TinyGrape Lab home">
          <img src="/media/brand-icon.png" alt="" width="32" height="32" />
          <span>TinyGrape <b>Lab</b></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href={localizedPath('/products', locale as Locale)}>{copy.nav.products}</a>
          <a href={localizedPath('/projects', locale as Locale)}>{copy.nav.projects}</a>
          <a href={localizedPath('/notes', locale as Locale)}>{copy.nav.notes}</a>
          <a href={localizedPath('/open-source', locale as Locale)}>{copy.nav.openSource}</a>
          <a href={localizedPath('/about', locale as Locale)}>{copy.nav.about}</a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
        <div class="language-switch"><a class={locale === 'en' ? 'active' : ''} href={localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'en')}>EN</a><span>/</span><a class={locale === 'zh' ? 'active' : ''} href={localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'zh')}>中文</a></div>
      </div>
      <nav id="mobile-menu" class="mobile-menu shell" aria-label="Mobile navigation">
        <a href={localizedPath('/products', locale as Locale)}>{copy.nav.products}</a>
        <a href={localizedPath('/projects', locale as Locale)}>{copy.nav.projects}</a>
        <a href={localizedPath('/notes', locale as Locale)}>{copy.nav.notes}</a>
        <a href={localizedPath('/open-source', locale as Locale)}>{copy.nav.openSource}</a>
        <a href={localizedPath('/about', locale as Locale)}>{copy.nav.about}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="shell footer-inner"><span>© {new Date().getFullYear()} TinyGrape Lab</span><div class="footer-links"><a href="https://github.com/ydsf16">GitHub</a><a href={localizedPath('/privacy', locale as Locale)}>Privacy</a><a href={localizedPath('/support', locale as Locale)}>Support</a></div></div></footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const mobileMenu = document.querySelector('#mobile-menu');
      menuButton?.addEventListener('click', () => {
        const open = mobileMenu?.classList.toggle('is-open') ?? false;
        menuButton.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
