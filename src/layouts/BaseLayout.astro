---
import '../styles/global.css';
import '../styles/detail.css';
import '../styles/scale.css';
import { siteCopy, localizedPath, type Locale } from '../data/site';
const { locale = 'en', title = 'TinyGrape Lab' } = Astro.props;
const normalizedLocale = locale as Locale;
const copy = siteCopy[normalizedLocale];
const description = Astro.props.description || copy.heroBody;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={`https://tinygrape.com.cn${localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'en')}`} />
    <link rel="alternate" hreflang="zh" href={`https://tinygrape.com.cn${localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'zh')}`} />
    <title>{title} · TinyGrape Lab</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localizedPath('/', locale as Locale)} aria-label="TinyGrape Lab home">
          <img src="/media/brand-icon.png" alt="" width="32" height="32" />
          <span>TinyGrape <b>Lab</b></span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={localizedPath('/products', locale as Locale)}>{copy.nav.products}</a>
          <a href={localizedPath('/projects', locale as Locale)}>{copy.nav.projects}</a>
          <a href={localizedPath('/notes', locale as Locale)}>{copy.nav.notes}</a>
          <a href={localizedPath('/open-source', locale as Locale)}>{copy.nav.openSource}</a>
          <a href={localizedPath('/about', locale as Locale)}>{copy.nav.about}</a>
        </nav>
        <div class="language-switch"><a class={locale === 'en' ? 'active' : ''} href={localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'en')}>EN</a><span>/</span><a class={locale === 'zh' ? 'active' : ''} href={localizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/', 'zh')}>中文</a></div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="shell footer-inner"><span>© {new Date().getFullYear()} TinyGrape Lab</span><span>{copy.footer}</span><div class="footer-links"><a href="https://github.com/ydsf16">GitHub</a><a href={localizedPath('/privacy', locale as Locale)}>Privacy</a><a href={localizedPath('/support', locale as Locale)}>Support</a></div></div></footer>
  </body>
</html>
