---
const { src, title = 'Embedded video' } = Astro.props;
const bilibiliMatch = src.match(/bilibili\.com\/video\/(BV[\w]+)/i);
const embedSrc = bilibiliMatch
  ? `https://player.bilibili.com/player.html?bvid=${bilibiliMatch[1]}&page=1&high_quality=1&danmaku=0`
  : src.includes('youtube.com/watch?v=')
    ? src.replace('watch?v=', 'embed/')
    : src.includes('youtu.be/')
      ? src.replace('youtu.be/', 'www.youtube.com/embed/')
      : src;
---
<div class="video-embed"><iframe src={embedSrc} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
