---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { type Locale } from '../../data/site'; export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }]; const locale = Astro.params.lang as Locale;
---
<BaseLayout locale={locale} title={locale === 'zh' ? '开源' : 'Open Source'}><section class="shell page-intro"><p class="eyebrow">OPEN SOURCE</p><a class="button primary" href="https://github.com/ydsf16">GitHub ↗</a></section></BaseLayout>
