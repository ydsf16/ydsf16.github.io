---
import { getCollection } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import ContentCard from '../../../components/ContentCard.astro'; import { type Locale } from '../../../data/site';
export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }]; const locale = Astro.params.lang as Locale; const items = await getCollection('projects', ({ data }) => data.lang === locale);
---
<BaseLayout locale={locale} title={locale === 'zh' ? '项目' : 'Projects'}><section class="shell page-intro"><p class="eyebrow">PROJECTS</p><p>{locale === 'zh' ? '从传感到空间智能，记录原型如何变成可复用的东西。' : 'From sensing to spatial intelligence, documenting how prototypes become useful.'}</p></section><section class="shell card-grid page-grid">{items.map((item) => <ContentCard item={item} locale={locale} kind="project">{item.body}</ContentCard>)}</section></BaseLayout>
