---
const target = '/zh/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline>window.location.replace('/zh/');</script>
  </head>
  <body></body>
</html>
